<Project>
    <!--
      Target frameworks (docs/agents/NET11_PLAN.md; test/Directory.Build.props mirrors this, keep them in sync).
      net10.0 (LTS) is the primary target. net11.0 is added only when the SDK building is 11 or newer, so SDK 10 keeps
      working; -p:NltgTargetNet11=false (or -f net10.0) builds net10.0 only with SDK 11. NETCoreSdkVersion is not set
      yet when Directory.Build.props is imported, so the SDK version comes from the directory MSBuild runs from
      (<dotnet>/sdk/<version>); anything that does not look like a version (e.g. Visual Studio's MSBuild) builds
      net10.0 only. Only one of TargetFramework/TargetFrameworks may be set: the SDK multi-targets only when
      TargetFramework is empty. LangVersion is pinned because with "latest" SDK 11 compiles net10.0 as C# 15.
    -->
    <PropertyGroup>
        <NltgSdkVersion>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([MSBuild]::EnsureTrailingSlash('$(MSBuildBinPath)'))))))</NltgSdkVersion>
        <NltgTargetNet11 Condition="'$(NltgTargetNet11)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(NltgSdkVersion)', '^\d+\.\d+\.\d+'))">$([MSBuild]::VersionGreaterThanOrEquals('$(NltgSdkVersion)', '11.0'))</NltgTargetNet11>
        <TargetFrameworks Condition="'$(NltgTargetNet11)' == 'true'">net10.0;net11.0</TargetFrameworks>
        <TargetFramework Condition="'$(NltgTargetNet11)' != 'true'">net10.0</TargetFramework>
    </PropertyGroup>

    <!--
      NativeAOT (NL-338, CLAUDE.md "NativeAOT"): the configuration binding source generator is on in every build, not
      only when PublishAot turns it on, so the JIT node, the tests and the AOT binary bind configuration with the same
      generated code, and a type it cannot bind (SYSLIB1100/SYSLIB1101) shows in the ordinary warning gate.
    -->
    <PropertyGroup>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <Deterministic>true</Deterministic>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <!--Package props-->
    <PropertyGroup>
        <Authors>Nickolas Goline</Authors>
        <Copyright>Copyright © Níckolas Goline 2024-2026</Copyright>
        <RepositoryUrl>https://github.com/ngoline/nlightning</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <NeutralLanguage>en</NeutralLanguage>
        <Icon>logo.png</Icon>
        <PackageIcon>logo.png</PackageIcon>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
</Project>
