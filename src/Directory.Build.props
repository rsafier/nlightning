<Project>
    <!--
      Target frameworks (docs/agents/NET11_PLAN.md, docs/agents/CSHARP15_PILOT.md; test/Directory.Build.props mirrors
      this, keep them in sync). Since the C# 15 pilot (NL-1086) the build requires SDK 11 (global.json) and compiles
      every project as C# 15 for both net10.0 (LTS, the primary runtime target) and net11.0. -p:NltgTargetNet11=false
      (or -f net10.0) builds net10.0 only. Only one of TargetFramework/TargetFrameworks may be set: the SDK
      multi-targets only when TargetFramework is empty.
    -->
    <PropertyGroup>
        <TargetFrameworks Condition="'$(NltgTargetNet11)' != 'false'">net10.0;net11.0</TargetFrameworks>
        <TargetFramework Condition="'$(NltgTargetNet11)' == 'false'">net10.0</TargetFramework>
    </PropertyGroup>

    <!--
      C# 15 unions on net10.0 (NL-1086): the compiler needs System.Runtime.CompilerServices.UnionAttribute and IUnion,
      which only the net11.0 runtime has. A project that declares a union sets NltgUnionPolyfill=true and gets the
      internal copies in src/Shared/Polyfills/ for net10.0 only (net11.0 uses the runtime's). Consumers of a union from
      another assembly need nothing. Two assemblies with the polyfill must not see each other's internals
      (InternalsVisibleTo), or CS0436 reports the duplicate.
    -->
    <ItemGroup Condition="'$(NltgUnionPolyfill)' == 'true' and '$(TargetFramework)' == 'net10.0'">
        <Compile Include="$(MSBuildThisFileDirectory)Shared/Polyfills/UnionPolyfills.cs" Link="Polyfills/UnionPolyfills.cs"/>
    </ItemGroup>

    <!--
      NativeAOT (NL-338, CLAUDE.md "NativeAOT"): the configuration binding source generator is on in every build, not
      only when PublishAot turns it on, so the JIT node, the tests and the AOT binary bind configuration with the same
      generated code, and a type it cannot bind (SYSLIB1100/SYSLIB1101) shows in the ordinary warning gate.
    -->
    <PropertyGroup>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>15</LangVersion>
        <!-- A switch expression that misses a union case (or enum value) fails the build (NL-1086). -->
        <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <Deterministic>true</Deterministic>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <!--Package props-->
    <PropertyGroup>
        <Authors>Nickolas Goline</Authors>
        <Copyright>Copyright © Níckolas Goline 2024-2026</Copyright>
        <RepositoryUrl>https://github.com/ngoline/nlightning</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <NeutralLanguage>en</NeutralLanguage>
        <Icon>logo.png</Icon>
        <PackageIcon>logo.png</PackageIcon>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
</Project>
