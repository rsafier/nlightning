<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Design-time only (NL-708): the startup project of `dotnet ef dbcontext optimize`, which writes the compiled models of
    NLightning.Infrastructure.Persistence (scripts/optimize_model.sh). It adds the design-time services the generator
    needs for our value objects. Nothing references it, and it is never part of the node.
  -->
  <PropertyGroup>
    <Configurations>Debug;Release;Debug.Native;Debug.Wasm;Release.Native;Release.Wasm</Configurations>
    <IsPackable>false</IsPackable>
    <!-- EF1001: CSharpHelper is EF's internal (pubternal) design-time API -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NLightning.Infrastructure.Persistence\NLightning.Infrastructure.Persistence.csproj"/>
    <ProjectReference Include="..\NLightning.Infrastructure.Repositories\NLightning.Infrastructure.Repositories.csproj"/>
  </ItemGroup>

</Project>
