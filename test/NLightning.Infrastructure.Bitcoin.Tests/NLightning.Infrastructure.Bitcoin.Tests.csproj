<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Configurations>Debug;Release;Debug.Native;Release.Native</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug.Native' ">
    <DebugSymbols Condition=" '$(DebugSymbols)' == '' ">true</DebugSymbols>
    <Optimize Condition=" '$(Optimize)' == '' ">false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release.Native' ">
    <Optimize Condition=" '$(Optimize)' == '' ">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0"/>
    <PackageReference Include="Moq" Version="4.20.72"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NLightning.Domain\NLightning.Domain.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Infrastructure.Bitcoin\NLightning.Infrastructure.Bitcoin.csproj"/>
    <ProjectReference Include="..\NLightning.Tests.Utils\NLightning.Tests.Utils.csproj"/>
  </ItemGroup>

  <!-- BOLT 5 on-chain tests (Onchain/, Builders/) run against the BOLT 3 Appendix C/F vectors: share the verbatim spec
       copies and the vector harness of NLightning.Integration.Tests instead of duplicating them -->
  <ItemGroup>
    <Compile Include="..\NLightning.Integration.Tests\BOLT3\Vectors\Bolt3SpecVectors.cs" Link="Bolt3\Vectors\Bolt3SpecVectors.cs"/>
    <Compile Include="..\NLightning.Integration.Tests\BOLT3\Bolt3VectorHarness.cs" Link="Bolt3\Bolt3VectorHarness.cs"/>
    <Compile Include="..\NLightning.Integration.Tests\BOLT3\Mocks\*.cs" Link="Bolt3\Mocks\%(Filename)%(Extension)"/>
    <Content Include="..\NLightning.Integration.Tests\BOLT3\Vectors\appendix-c.txt;..\NLightning.Integration.Tests\BOLT3\Vectors\appendix-f.json" Link="BOLT3\Vectors\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
