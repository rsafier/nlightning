<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Configurations>Debug;Release;Debug.Native;Release.Native</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug.Native' ">
    <DebugSymbols Condition=" '$(DebugSymbols)' == '' ">true</DebugSymbols>
    <Optimize Condition=" '$(Optimize)' == '' ">false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release.Native' ">
    <Optimize Condition=" '$(Optimize)' == '' ">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Only the Tor fixture and the SQL Server fixture drive Docker (NL-866, Fixtures/DockerAbsenceTests) -->
    <PackageReference Include="Docker.DotNet" Version="3.125.15"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0"/>
    <PackageReference Include="Moq" Version="4.20.72"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NLightning.Application\NLightning.Application.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Daemon\NLightning.Daemon.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Infrastructure.Repositories\NLightning.Infrastructure.Repositories.csproj"/>
    <ProjectReference Include="..\NLightning.Tests.Utils\NLightning.Tests.Utils.csproj"/>
    <!-- The Kubernetes harness, for Cluster/ (our in-process node in a cluster topology); it references no product
         project, so the glue lives here, next to NLightningTestNode -->
    <ProjectReference Include="..\NLightning.Testing.Cluster\NLightning.Testing.Cluster.csproj"/>
    <ProjectReference Include="..\NLightning.Testing.Lnd\NLightning.Testing.Lnd.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Infrastructure.Serialization\NLightning.Infrastructure.Serialization.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Bolt11\NLightning.Bolt11.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Domain\NLightning.Domain.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Infrastructure.Bitcoin\NLightning.Infrastructure.Bitcoin.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Infrastructure\NLightning.Infrastructure.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Infrastructure.Persistence.Postgres\NLightning.Infrastructure.Persistence.Postgres.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Infrastructure.Persistence.Sqlite\NLightning.Infrastructure.Persistence.Sqlite.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Infrastructure.Persistence.SqlServer\NLightning.Infrastructure.Persistence.SqlServer.csproj"/>
    <ProjectReference Include="..\..\src\NLightning.Infrastructure.Persistence\NLightning.Infrastructure.Persistence.csproj"/>
  </ItemGroup>

  <!-- The taproot two-node harness and its D-T4 crash proof, run on Postgres by Docker/TaprootPostgresCrashTests in the
       cluster's postgres suite (NL-960) -->
  <ItemGroup>
    <Compile Include="..\NLightning.Application.Tests\Channels\Taproot\TaprootOpenHarness.cs" Link="Persistence\Taproot\TaprootOpenHarness.cs"/>
    <Compile Include="..\NLightning.Application.Tests\Channels\Taproot\TaprootCrashProof.cs" Link="Persistence\Taproot\TaprootCrashProof.cs"/>
    <Compile Include="..\NLightning.Application.Tests\Channels\Harness\RecordingPaymentHandler.cs" Link="Persistence\Taproot\RecordingPaymentHandler.cs"/>
    <Compile Include="..\NLightning.Application.Tests\Channels\DualFunding\HarnessLinkProbe.cs" Link="Persistence\Taproot\HarnessLinkProbe.cs"/>
    <Compile Include="..\NLightning.Application.Tests\TestUtils\SqliteTestPools.cs" Link="Persistence\Taproot\SqliteTestPools.cs"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="BOLT11/Vectors/ValidInvoices.txt" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="BOLT4/Vectors/*.json" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="BOLT12/Vectors/*.json" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="BOLT3/Vectors/*.txt;BOLT3/Vectors/*.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
