<Project>

  <!--
    Test projects target what src/Directory.Build.props targets (keep the two in sync): net10.0 and net11.0, compiled
    as C# 15 with SDK 11 (global.json; -p:NltgTargetNet11=false or -f net10.0 builds net10.0 only). The Blazor
    projects (Release.Wasm, CI only) set their own TargetFramework and stay single-target.
  -->
  <PropertyGroup>
    <LangVersion>15</LangVersion>
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    <NltgMultiTarget Condition="'$(NltgTargetNet11)' != 'false' and !$(MSBuildProjectDirectory.Contains('BlazorTests'))">true</NltgMultiTarget>
    <!-- Only one of the two may be set: the SDK multi-targets only when TargetFramework is empty. -->
    <TargetFrameworks Condition="'$(NltgMultiTarget)' == 'true'">net10.0;net11.0</TargetFrameworks>
    <TargetFramework Condition="'$(NltgMultiTarget)' != 'true'">net10.0</TargetFramework>
  </PropertyGroup>

</Project>